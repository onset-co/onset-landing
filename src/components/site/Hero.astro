---
import Waveform from './Waveform.astro';
---

<section class="hero">
	<div class="hero__wave">
		<Waveform bars={72} seed={3} />
	</div>
	<div class="container hero__inner">
		<div class="hero__brand" aria-label="آنسِت | Onset">
			<img class="hero__logo" src="/logo.png" alt="" width="56" height="56" />
			<span class="hero__mark">Onset</span>
		</div>
		<h1 class="hero__title">جایی که غیرممکن آغاز می‌شود</h1>
		<p class="hero__sub">
			آنسِت یک استودیو ساخت راهکارهای نرم‌افزاری کارآمد است
		</p>
		<a class="hero__cta visible-focus" href="#beatmic">
			<span>آشنایی با بیت‌میک</span>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path
					d="M8 3v10M8 13l-4-4M8 13l4-4"
					stroke="currentColor"
					stroke-width="1.4"
					stroke-linecap="round"
					stroke-linejoin="round"
				></path>
			</svg>
		</a>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 92svh;
		display: flex;
		align-items: center;
		overflow: hidden;
		background: radial-gradient(120% 90% at 50% 0%, #0b1128 0%, var(--bg) 62%);
	}
	.hero__wave {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		height: 34%;
		opacity: 0.22;
		mask-image: linear-gradient(180deg, transparent, black 78%);
		-webkit-mask-image: linear-gradient(180deg, transparent, black 78%);
	}
	.hero__inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.75rem;
		padding-block: 6rem;
		text-align: start;
	}
	.hero__mark {
		font-family: 'Vazirmatn Variable', sans-serif;
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: 0.02em;
		color: var(--ink);
	}
	.hero__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
	}
	.hero__logo {
		width: 3.5rem;
		height: 3.5rem;
		object-fit: contain;
	}
	.hero__title {
		font-size: clamp(2.1rem, 5vw, 3.4rem);
		font-weight: 700;
		max-width: 16ch;
		letter-spacing: -0.01em;
	}
	.hero__sub {
		font-size: 1.15rem;
		line-height: 1.85;
		max-width: 46ch;
	}
	.hero__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 0.75rem;
		padding-block: 0.4rem;
		color: var(--ink);
		text-decoration: none;
		font-weight: 500;
		border-bottom: 1px solid var(--line-strong);
		transition: border-color 0.2s ease, color 0.2s ease;
	}
	.hero__cta svg {
		transition: transform 0.2s ease;
	}
	.hero__cta:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.hero__cta:hover svg {
		transform: translateY(3px);
	}
	@media (max-width: 640px) {
		.hero {
			min-height: 82svh;
		}
		.hero__inner {
			padding-block: 4rem;
		}
	}
</style>
