---
const features = [
	'تاخیر خیلی کم، مناسب پخش زنده‌ی صدا',
	'جلوه‌های صوتی واقعی: اکو، ریوِرب، اکولایزر، کمپرسور',
	'محافظ سوت، همیشه فعال در برابر فیدبک ناخواسته',
	'هم‌زمانی با اپ‌های موسیقی دیگر در حالت Mix',
	'نمای ساده برای استفاده‌ی سریع، نمای پیشرفته برای کنترل دقیق',
];

// TODO(onset): replace with the live Cafe Bazaar product URL once BeatMic is published.
const BAZAAR_URL = 'https://cafebazaar.ir/app/com.onset.beatmic';
---

<section class="beatmic" id="beatmic">
	<div class="container beatmic__inner">
		<div class="beatmic__visual">
			<img
				class="beatmic__screenshot"
				src="/Screenshot_BeatMic_1.jpg"
				alt="نمایی از رابط کاربری بیت‌میک"
				width="1080"
				height="2340"
				loading="lazy"
			/>
		</div>

		<div class="beatmic__content">
			<span class="beatmic__eyebrow">اولین محصول آنسِت</span>
			<h2 class="beatmic__title">بیت‌میک</h2>
			<p class="beatmic__subhead">گوشی‌ات را به یک میکروفون حرفه‌ای تبدیل کن.</p>
			<p class="beatmic__body">
				وقتی بلندگو داری ولی میکروفون نه؛ سالن ارائه، کلاس، مهمانی یا تمرین
				خواندن. کافی‌ست گوشی را به بلندگو وصل کنی، بیت‌میک را باز کنی و
				دکمه‌ی شروع را بزنی. صدایت آنی و با تاخیری خیلی کم پخش می‌شود.
			</p>

			<ul class="beatmic__features">
				{
					features.map((f) => (
						<li>
							<span class="beatmic__feature-mark" />
							{f}
						</li>
					))
				}
			</ul>

			<a class="beatmic__cta visible-focus" href={BAZAAR_URL} target="_blank" rel="noopener">
				دریافت از کافه‌بازار
			</a>
		</div>
	</div>
</section>

<style>
	.beatmic {
		background: linear-gradient(180deg, var(--bg-raised) 0%, var(--bg-raised-2) 100%);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding-block: clamp(5rem, 9vw, 8rem);
	}
	.beatmic__inner {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
	}
	.beatmic__eyebrow {
		display: inline-block;
		color: var(--accent);
		font-weight: 500;
		font-size: 0.95rem;
		margin-bottom: 0.9rem;
	}
	.beatmic__title {
		font-size: clamp(2rem, 4vw, 2.6rem);
		font-weight: 700;
	}
	.beatmic__subhead {
		color: var(--ink);
		font-size: 1.2rem;
		margin-top: 0.6rem;
		max-width: 32ch;
	}
	.beatmic__body {
		margin-top: 1.1rem;
		font-size: 1.05rem;
		max-width: 48ch;
	}
	.beatmic__features {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}
	.beatmic__features li {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
		color: var(--ink);
		font-size: 1rem;
		max-width: 46ch;
	}
	.beatmic__feature-mark {
		flex: none;
		width: 7px;
		height: 7px;
		margin-top: 0.55rem;
		border-radius: 50%;
		background: var(--accent);
	}
	.beatmic__cta {
		display: inline-flex;
		align-items: center;
		margin-top: 2.4rem;
		padding: 0.9rem 1.9rem;
		background: var(--accent);
		color: var(--accent-ink);
		font-weight: 700;
		font-size: 1rem;
		border-radius: 999px;
		text-decoration: none;
		transition: filter 0.2s ease, transform 0.2s ease;
	}
	.beatmic__cta:hover {
		filter: brightness(1.08);
		transform: translateY(-1px);
	}

	.beatmic__visual {
		display: flex;
		justify-content: center;
	}
	.beatmic__screenshot {
		width: 100%;
		height: auto;
		max-width: 300px;
		aspect-ratio: 1080 / 2340;
		object-fit: contain;
		border: 1px solid var(--line-strong);
		border-radius: 28px;
		box-shadow: var(--shadow);
	}

	@media (max-width: 860px) {
		.beatmic__inner {
			grid-template-columns: 1fr;
		}
		.beatmic__visual {
			order: -1;
		}
		.beatmic__screenshot {
			max-width: 220px;
		}
	}
</style>
