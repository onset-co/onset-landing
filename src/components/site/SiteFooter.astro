---
const year = new Intl.DateTimeFormat('fa-IR-u-ca-persian', { year: 'numeric' }).format(new Date());
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<a class="site-footer__brand" href="/" aria-label="آنسِت | Onset">
			<img src="/logo.png" alt="" width="36" height="36" />
			<span class="site-footer__mark">Onset</span>
		</a>
		<nav class="site-footer__nav" aria-label="پیوندهای پایین صفحه">
			<a href="#beatmic">بیت‌میک</a>
			<a href="#beaton">بیت‌آن</a>
			<a href="#about">درباره‌ی آنسِت</a>
		</nav>
		<p class="site-footer__line">ساخته‌شده در ایران · {year}</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--bg);
		padding-block: 2.75rem;
	}
	.site-footer__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		flex-wrap: wrap;
	}
	.site-footer__mark {
		font-weight: 700;
		color: var(--ink-dim);
		font-size: 0.95rem;
	}
	.site-footer__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
	}
	.site-footer__brand img {
		width: 2.25rem;
		height: 2.25rem;
		object-fit: contain;
	}
	.site-footer__line {
		color: var(--ink-faint);
		font-size: 0.9rem;
		margin: 0;
	}
	.site-footer__nav { display: flex; flex-wrap: wrap; gap: 1.25rem; }
	.site-footer__nav a { color: var(--ink-faint); font-size: 0.84rem; text-decoration: none; transition: color 0.2s ease; }
	.site-footer__nav a:hover { color: var(--ink); }
	@media (max-width: 640px) {
		.site-footer { padding-block: 2rem; }
		.site-footer__inner { align-items: flex-start; }
		.site-footer__nav { order: 3; width: 100%; padding-top: 0.5rem; border-top: 1px solid var(--line); }
		.site-footer__line { font-size: 0.8rem; }
	}
</style>
